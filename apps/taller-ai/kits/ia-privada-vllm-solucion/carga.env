# carga.env: la prueba de carga de una copia de vLLM (paso 3). La leen pipeline/carga.py, pipeline/reporte.py y mundo/gpu.py.
# Abierta: llegadas al azar (Poisson) a esta tasa, en preguntas por segundo. El despacho: 0.21/s entre 3 copias
TASA=0.07
PETICIONES=40
# Cerrada: cuántas conversaciones a la vez (las 8 de diseño) y cuántas preguntas en total
CERRADA_A_LA_VEZ=8
CERRADA_PETICIONES=24
# Tope de salida por respuesta (el del plan de la prueba)
MAX_TOKENS=500
# La semilla de las preguntas y de las llegadas: la misma en tu Mac y en la GPU
SEMILLA=11
# El criterio del despacho: TTFT p95 y TPOT p95, en milisegundos
TTFT_MS=2000
TPOT_MS=50
