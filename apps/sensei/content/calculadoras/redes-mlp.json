{
  "titulo": "Un MLP que recibe la foto entera",
  "intro": "Una capa oculta densa y una de salida. Mueve el tamaño de la foto y mira cómo crecen los [[parametro|parámetros]] de la primera capa: cada píxel de cada canal necesita un peso por cada neurona oculta.",
  "entradas": [
    {
      "id": "n",
      "label": "Lado de la foto, en píxeles",
      "min": 8,
      "max": 512,
      "paso": 4,
      "valor": 28
    },
    {
      "id": "c",
      "label": "Canales (1 = gris, 3 = color)",
      "min": 1,
      "max": 3,
      "paso": 2,
      "valor": 1
    },
    {
      "id": "h",
      "label": "Neuronas de la capa oculta",
      "min": 16,
      "max": 4096,
      "paso": 16,
      "valor": 128
    },
    {
      "id": "o",
      "label": "Salidas (una por categoría)",
      "min": 2,
      "max": 1000,
      "paso": 1,
      "valor": 10
    }
  ],
  "calculos": [
    {
      "id": "e",
      "formula": "n * n * c"
    },
    {
      "id": "p1",
      "formula": "e * h + h"
    },
    {
      "id": "p2",
      "formula": "h * o + o"
    }
  ],
  "salidas": [
    {
      "label": "Entradas",
      "formula": "e",
      "formato": "int",
      "nota": "lado × lado × canales"
    },
    {
      "label": "Parámetros de la capa oculta",
      "formula": "p1",
      "formato": "int",
      "nota": "entradas × ocultas + ocultas"
    },
    {
      "label": "Parámetros de la capa de salida",
      "formula": "p2",
      "formato": "int",
      "nota": "ocultas × salidas + salidas"
    },
    {
      "label": "Parámetros en total",
      "formula": "p1 + p2",
      "formato": "int"
    },
    {
      "label": "Tamaño contra la ResNet-50 de C01",
      "formula": "(p1 + p2) / 24532532",
      "formato": "pct",
      "barra": true,
      "nota": "100 % = sus 24,532,532 parámetros",
      "decimales": 1
    },
    {
      "label": "Memoria en float32",
      "formula": "(p1 + p2) * 4",
      "formato": "bytes",
      "nota": "4 bytes por parámetro"
    },
    {
      "label": "MACs por foto",
      "formula": "e * h + h * o",
      "formato": "int",
      "nota": "una por peso"
    }
  ],
  "nota": "Con 224 × 224 en color y solo 128 ocultas, la primera capa ya tiene 19.3 millones de parámetros, y cada peso conecta un solo número de la foto (un píxel de un color) con una sola neurona."
}