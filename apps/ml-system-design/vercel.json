{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/web",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "ronda-diseno-ml.vercel.app"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|Crawler|spider|Spider|facebookexternalhit|WhatsApp|Slurp|Google-InspectionTool|embedly|Embedly|Iframely|vkShare).*"
        }
      ],
      "destination": "https://ronda.trueml.app/$1",
      "permanent": true
    },
    {
      "source": "/((?!mudanza\\.html$|mudanza\\.js$|sw\\.js$).*)",
      "has": [
        {
          "type": "host",
          "value": "ronda-diseno-ml.vercel.app"
        }
      ],
      "destination": "/mudanza.html?a=/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
