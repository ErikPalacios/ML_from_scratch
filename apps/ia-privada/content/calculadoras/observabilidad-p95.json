  "entradas": [
    {
      "id": "qq",
      "label": "Percentil, \\(q\\) (95 = el p95)",
      "min": 50,
      "max": 99.9,
      "paso": 0.1,
      "valor": 95
    },
    {
      "id": "e1",
      "label": "Borde 1, en s",
      "min": 0.05,
      "max": 60,
      "paso": 0.05,
      "valor": 1.0,
      "tipo": "numero"
    },
    {
      "id": "c1",
      "label": "Conteo acumulado ≤ borde 1",
