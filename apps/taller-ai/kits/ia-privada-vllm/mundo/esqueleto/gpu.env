# gpu.env: la sesión en la GPU rentada (paso 6). La lee mundo/gpu.py. La llave de RunPod NO va aquí: va en la terminal.
# Dónde y qué: el proveedor de mundo/proveedores.json y la GPU
PROVEEDOR=
GPU=
# Lo que cobra: US$ por hora de la GPU, y el disco del contenedor (GB y US$ por GB al mes mientras corre)
USD_HORA=
DISCO_GB=
USD_GB_MES=
# El tope: a los MINUTOS de lanzar el vigía, el pod se termina solo
MINUTOS=
# Pesos por dólar (el FIX de Banxico del día), para el costo en MXN
TIPO_CAMBIO=
# El id del pod (RunPod → Pods), cuando ya lo lanzaste
POD_ID=
