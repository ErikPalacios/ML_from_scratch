    "lib": "transformers",
    "ctor": "DetrForObjectDetection._from_config(DetrConfig(**{'num_labels': 91, 'd_model': 256, 'encoder_layers': 6, 'decoder_layers': 6, 'encoder_attention_heads': 8, 'decoder_attention_heads': 8, 'activation_function': 'relu', 'position_embedding_type': 'sine', 'encoder_ffn_dim': 2048, 'decoder_ffn_dim': 2048, 'auxiliary_loss': False, 'num_queries': 100}), attn_implementation='eager')",
