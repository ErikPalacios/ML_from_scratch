# juez.env: qué sirve el segundo llama-server, el del juez. Lo leen servir-juez.sh (con source) y pipeline/juez.py.
# El archivo del modelo, relativo a esta carpeta (el del catálogo: mundo/modelos.json). Otro modelo, más grande que el de la API.
MODELO=modelo/juez/Qwen3-4B-Q4_K_M.gguf
ALIAS=juez
HOST=127.0.0.1
PUERTO=9933
# Un veredicto a la vez: con 8,192 de sobra (una calificación usa ≈ 300 tokens)
CONTEXTO=8192
PARALELO=1
# El razonamiento de Qwen3, apagado: el juez contesta solo el JSON
RAZONAMIENTO=off
CLAVE=dojo-local-7f3a
