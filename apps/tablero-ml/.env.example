# Copia a .env.local para npm run dev (git ignora .env.local). En Vercel van como variables de entorno.
APP_PASSWORD=
SESSION_SECRET=
API_TOKEN=
# Opcional: zona horaria de las fechas del servidor (por defecto America/Mexico_City)
TABLERO_TZ=
# Opcional en local: usar la base de Upstash en vez de .data/dev-store.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
