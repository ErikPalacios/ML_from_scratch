    "lib": "transformers",
    "ctor": "SamModel._from_config(SamConfig(vision_config={'hidden_size': 1280, 'num_hidden_layers': 32, 'num_attention_heads': 16, 'global_attn_indexes': [7, 15, 23, 31], 'image_size': 1024}, prompt_encoder_config={'image_size': 1024}), attn_implementation='eager')",
