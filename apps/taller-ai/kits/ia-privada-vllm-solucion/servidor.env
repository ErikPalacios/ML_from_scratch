# servidor.env: qué sirve vLLM y cómo. Lo leen servir.sh, mundo/gpu.py, pipeline/ y verificar.py.
# El modelo, como se llama en Hugging Face (el del despacho)
MODELO=Qwen/Qwen3-32B-AWQ
# El nombre con el que la API lo anuncia: el «model» de cada petición
NOMBRE=qwen3-32b
# Dónde escucha en tu Mac (en el pod, mundo/gpu.py receta lo cambia a 0.0.0.0 para el proxy)
HOST=127.0.0.1
PUERTO=8000
# Tokens por conversación (prompt + respuesta): ≈ 6,000 de entrada + 500 de salida caben en 8,192
MAX_MODEL_LEN=8192
# Conversaciones a la vez en el motor: las 8 de diseño del despacho
MAX_NUM_SEQS=8
# La llave de la API: cada petición manda «Authorization: Bearer <CLAVE>»
CLAVE=dojo-vllm-5c1e9a
# Lo que usan tus programas: la URL base de la API (en la sesión de GPU, la del proxy del pod)
LLM_URL=http://127.0.0.1:8000/v1
