{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node tools/build.mjs",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sensei-ml.vercel.app"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|Crawler|spider|Spider|facebookexternalhit|WhatsApp|Slurp|Google-InspectionTool|embedly|Embedly|Iframely|vkShare).*"
        }
      ],
      "destination": "https://sensei.trueml.app/:path*",
      "permanent": true
    },
    {
      "source": "/((?!mudanza\\.html$|mudanza\\.js$|sw\\.js$).*)",
      "has": [
        {
          "type": "host",
          "value": "sensei-ml.vercel.app"
        }
      ],
      "destination": "/mudanza.html?a=/$1",
      "permanent": false
    },
    {
      "source": "/ronda/",
      "destination": "/que-sigue/",
      "permanent": true
    },
    {
      "source": "/ronda",
      "destination": "/que-sigue/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
