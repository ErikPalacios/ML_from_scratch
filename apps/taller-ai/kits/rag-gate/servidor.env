# servidor.env: qué sirve llama-server y cómo. Lo leen servir.sh (con source), pipeline/llm.py y verificar.py.
# El archivo del modelo, relativo a esta carpeta (el del catálogo: mundo/modelos.json)
MODELO=modelo/llm/Qwen3-0.6B-Q8_0.gguf
# El nombre con el que la API anuncia el modelo (el «model» de cada petición)
ALIAS=qwen3-0.6b
# Dónde escucha: 127.0.0.1 es solo esta Mac; nadie más en la red llega
HOST=127.0.0.1
PUERTO=9931
# Tokens que caben por petición (prompt + respuesta): el despacho pide 8,192
CONTEXTO=8192
# Cuántas peticiones a la vez; el contexto se reparte entre ellas
PARALELO=1
# El razonamiento de Qwen3 (on, off o auto): apagado
RAZONAMIENTO=off
# La llave de la API: cada petición manda «Authorization: Bearer <CLAVE>»
CLAVE=dojo-local-7f3a
# Lo que usa el cliente: la URL base de la API compatible con OpenAI (host, puerto y /v1)
LLM_URL=http://127.0.0.1:9931/v1
