  "not_hooked": {
    "pos-sine / level-table / pos": "pos-sine = suma de las PE por nivel (forward hook de position_embedding, una llamada por nivel); level-table = forma de level_embed; pos = pos-sine + level_embed (sin módulo)",
    "query-pos / tgt0": "query_position_embeddings.weight (Q×2D) partido en dos (torch.split dentro del forward); tgt0 = entrada de decoder.layers.0",
    "e-aw / e-sampled / d-cross-aw / d-cross-sampled": "softmax y grid_sample dentro de MultiScaleDeformableAttention: e-aw sale de las attention weights (B, N, h, L, K) que recibe; e-sampled = h×N×LK×d_h (lo arma grid_sample nivel por nivel)",
    "d-ref": "sigmoid funcional sobre reference_points(query_pos): misma forma que d-ref-logits",
    "box-ref / box-logits / boxes": "suma de inverse_sigmoid(ref) y sigmoid funcionales; boxes = pred_boxes",
    "cost / assignment / loss / gt-*": "solo entrenamiento (necesita labels y scipy): no se ejecuta"
  },
