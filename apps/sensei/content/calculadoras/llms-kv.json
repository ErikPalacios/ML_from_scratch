{
  "titulo": "La memoria del KV cache",
  "intro": "Por cada token se guardan una K y una V en cada bloque. Los valores iniciales son los de Llama 3 8B en una L4, con la memoria que les queda después de los pesos.",
  "entradas": [
    { "id": "capas", "label": "Bloques del modelo", "min": 1, "max": 128, "paso": 1, "valor": 32 },
    { "id": "kvh", "label": "Juegos de K y V por bloque", "min": 1, "max": 128, "paso": 1, "valor": 8 },
    { "id": "d", "label": "Números por cada K o V", "min": 32, "max": 256, "paso": 32, "valor": 128 },
    { "id": "b", "label": "Bytes por número (2 = BF16, 1 = FP8)", "min": 0.5, "max": 4, "paso": 0.5, "valor": 2 },
    { "id": "t", "label": "Tokens por conversación", "min": 1, "max": 131072, "paso": 1, "valor": 8192, "tipo": "numero" },
    { "id": "u", "label": "Conversaciones a la vez", "min": 1, "max": 256, "paso": 1, "valor": 4 },
    { "id": "libre", "label": "Memoria libre para el KV cache", "min": 0.5, "max": 160, "paso": 0.1, "valor": 3.5, "unidad": "GB" }
  ],
  "calculos": [
    { "id": "porToken", "formula": "2 * capas * kvh * d * b" },
    { "id": "porConv", "formula": "porToken * t" }
  ],
  "salidas": [
    { "label": "Por token, en KiB", "formula": "porToken / 1024", "formato": "num", "decimales": 0, "nota": "2 × bloques × juegos × números × bytes ÷ 1,024" },
    { "label": "Por conversación", "formula": "porConv", "formato": "bytes", "nota": "por token × tokens" },
    { "label": "Todas las conversaciones", "formula": "porConv * u", "formato": "bytes", "barra": true, "nota": "lo que necesitas" },
    { "label": "Memoria libre", "formula": "libre * 1000000000", "formato": "bytes", "barra": true, "nota": "lo que tienes" },
    { "label": "Conversaciones que caben", "formula": "floor(libre * 1000000000 / porConv)", "formato": "int", "nota": "memoria libre ÷ por conversación" }
  ],
  "nota": "Prueba Llama 3 70B en una réplica de C10: 80 bloques, 2,250 tokens y 68.4 GB libres. Caben 92 conversaciones enteras. Después pon 32 juegos de K y V en vez de 8: así sería sin GQA."
}
