{
  "titulo": "Tamaño de muestra de un A/B",
  "intro": "Cuántas unidades necesita cada brazo para ver un efecto. Empieza en C01: aceptación de 70 %, un efecto mínimo de 1 punto, α = 0.05 de dos colas y potencia de 80 %.",
  "entradas": [
    { "id": "base", "label": "Tasa del control (la de hoy)", "min": 1, "max": 95, "paso": 0.5, "valor": 70, "unidad": "%" },
    { "id": "mde", "label": "Efecto mínimo que quieres ver (MDE)", "min": 0.1, "max": 10, "paso": 0.1, "valor": 1, "unidad": "puntos" },
    { "id": "pot", "label": "Potencia", "min": 50, "max": 99, "paso": 1, "valor": 80, "unidad": "%" },
    { "id": "alfa", "label": "Significancia α", "min": 0.1, "max": 20, "paso": 0.1, "valor": 5, "unidad": "%" }
  ],
  "calculos": [
    { "id": "p1", "formula": "base / 100" },
    { "id": "p2", "formula": "min(p1 + mde / 100, 0.999)" },
    { "id": "pm", "formula": "(p1 + p2) / 2" },
    { "id": "qa", "formula": "alfa / 200" },
    { "id": "qb", "formula": "max(1 - pot / 100, 1e-6)" },
    { "id": "ta", "formula": "sqrt(-2 * log(qa))" },
    { "id": "ra", "formula": "(qa - 0.5) * (qa - 0.5)" },
    { "id": "za", "formula": "qa < 0.02425 ? -(((((-7.784894002430293e-03 * ta - 3.223964580411365e-01) * ta - 2.400758277161838e+00) * ta - 2.549732539343734e+00) * ta + 4.374664141464968e+00) * ta + 2.938163982698783e+00) / ((((7.784695709041462e-03 * ta + 3.224671290700398e-01) * ta + 2.445134137142996e+00) * ta + 3.754408661907416e+00) * ta + 1) : -(((((-3.969683028665376e+01 * ra + 2.209460984245205e+02) * ra - 2.759285104469687e+02) * ra + 1.383577518672690e+02) * ra - 3.066479806614716e+01) * ra + 2.506628277459239e+00) * (qa - 0.5) / (((((-5.447609879822406e+01 * ra + 1.615858368580409e+02) * ra - 1.556989798598866e+02) * ra + 6.680131188771972e+01) * ra - 1.328068155288572e+01) * ra + 1)" },
    { "id": "tb", "formula": "sqrt(-2 * log(qb))" },
    { "id": "rb", "formula": "(qb - 0.5) * (qb - 0.5)" },
    { "id": "zb", "formula": "qb < 0.02425 ? -(((((-7.784894002430293e-03 * tb - 3.223964580411365e-01) * tb - 2.400758277161838e+00) * tb - 2.549732539343734e+00) * tb + 4.374664141464968e+00) * tb + 2.938163982698783e+00) / ((((7.784695709041462e-03 * tb + 3.224671290700398e-01) * tb + 2.445134137142996e+00) * tb + 3.754408661907416e+00) * tb + 1) : -(((((-3.969683028665376e+01 * rb + 2.209460984245205e+02) * rb - 2.759285104469687e+02) * rb + 1.383577518672690e+02) * rb - 3.066479806614716e+01) * rb + 2.506628277459239e+00) * (qb - 0.5) / (((((-5.447609879822406e+01 * rb + 1.615858368580409e+02) * rb - 1.556989798598866e+02) * rb + 6.680131188771972e+01) * rb - 1.328068155288572e+01) * rb + 1)" },
    { "id": "n", "formula": "pow(za * sqrt(2 * pm * (1 - pm)) + zb * sqrt(p1 * (1 - p1) + p2 * (1 - p2)), 2) / max(pow(p2 - p1, 2), 1e-12)" }
  ],
  "salidas": [
    { "label": "Unidades por brazo", "formula": "ceil(n)", "formato": "int", "barra": true, "nota": "la fórmula de dos proporciones" },
    { "label": "En los dos brazos", "formula": "2 * ceil(n)", "formato": "int" },
    { "label": "Regla rápida, con el factor exacto", "formula": "2 * pow(za + zb, 2) * p1 * (1 - p1) / pow(p2 - p1, 2)", "formato": "int", "barra": true, "nota": "2 × (z de α + z de potencia)² × p(1 − p) ÷ MDE²; con 5 % y 80 % el factor es 15.7, que la regla de bolsillo redondea a 16" },
    { "label": "z de α", "formula": "za", "decimales": 2, "nota": "1.96 con α = 5 %" },
    { "label": "z de la potencia", "formula": "zb", "decimales": 2, "nota": "0.84 con 80 %" },
    { "label": "Horas para juntarla en C01, al 50/50", "formula": "2 * ceil(n) / (2500000 / 24)", "decimales": 1, "nota": "con ≈ 2.5 M publicaciones al día" }
  ],
  "nota": "n crece con 1 ÷ efecto²: divide el MDE entre 2 y la muestra se multiplica por 4. Y aunque la muestra se junte en horas, el A/B de C01 corre semanas completas."
}
