{
  "name": "atlas-arquitecturas",
  "version": "0.1.0",
  "description": "Atlas de Arquitecturas: modelos de ML a nivel 2 (diagrama de bloques, matemáticas y dimensiones) para entrevistas de ML/AI Engineer.",
  "private": true,
  "scripts": {
    "validate": "node tools/validate-content.mjs",
    "test": "node --test \"tests/*.test.cjs\"",
    "crosscheck": "node tools/crosscheck-compare.mjs",
    "contrast": "node tools/contrast-check.mjs",
    "vendor:lab": "node ../transformer-lab/build.mjs && cp ../transformer-lab/dist/transformer-lab.html vendor/lab/index.html",
    "build": "node build.mjs",
    "check": "node tools/browser-check.mjs --url index.html",
    "smoke": "node tools/browser-check.mjs --url index.html --wait 2500 --timeout 240000 --eval-file tools/smoke.js --light",
    "smoke:mobile": "node tools/browser-check.mjs --url index.html --wait 2500 --timeout 240000 --eval-file tools/smoke.js --mobile --width 375 --height 812",
    "smoke:dark": "node tools/browser-check.mjs --url index.html --wait 2500 --timeout 240000 --eval-file tools/smoke.js --dark",
    "smoke:tablet": "node tools/browser-check.mjs --url index.html --width 768 --height 1024 --wait 2500 --timeout 240000 --eval-file tools/smoke.js --light",
    "smoke:dist": "node build.mjs && node tools/browser-check.mjs --url dist/atlas-arquitecturas.html --wait 2500 --timeout 240000 --eval-file tools/smoke.js --light",
    "build:web": "node build.mjs && node tools/build-web.mjs",
    "build:vercel": "node build.mjs && node tools/build-web.mjs"
  },
  "engines": { "node": ">=20" }
}
